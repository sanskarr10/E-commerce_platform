{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Turns order events into in-app notifications and emails.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "amqplib": "^2.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
