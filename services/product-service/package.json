{
  "name": "product-service",
  "version": "0.1.0",
  "private": true,
  "description": "Product catalog service: CRUD, search, atomic stock, Redis caching.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "amqplib": "^2.4.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "swagger-ui-dist": "^5.35.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
