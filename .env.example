# Copy to .env (make up does this for you). Never commit the real .env.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in connection URLs.

# --- Gateway ---
GATEWAY_PORT=8080
STOREFRONT_PORT=8081
ADMIN_PORT=8082
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- PostgreSQL (users_db, orders_db, payments_db) ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_postgres

# --- MySQL (product catalog) ---
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=catalog
MYSQL_USER=catalog
MYSQL_PASSWORD=change_me_mysql

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=change_me_rabbit

# --- Bootstrap admin account created by user-service on startup (leave empty to skip) ---
ADMIN_EMAIL=admin@shop.dev
ADMIN_PASSWORD=ChangeMe123
