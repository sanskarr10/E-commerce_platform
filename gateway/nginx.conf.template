# API gateway. The official nginx image renders this file with envsubst at startup
# (only ${NGINX_RESOLVER} is substituted; nginx's own $variables are left alone).

limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=20r/s;

server {
    listen 80;
    server_name _;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    client_max_body_size 1m;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    # Headers inherited by every proxied location.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id; # correlation id, logged by every service
    proxy_hide_header X-Request-ID;            # services echo it back; avoid a duplicate header
    add_header X-Request-ID $request_id always;
    add_header X-Content-Type-Options nosniff always;

    # Upstreams are variables, so nginx resolves them per request. The gateway still
    # boots when a service is down or not built yet, and answers 503 instead of crashing.
    set $user_service http://user-service:8000;
    set $product_service http://product-service:3000;
    set $order_service http://order-service:8000;
    set $payment_service http://payment-service:8000;

    error_page 502 503 504 = @upstream_unavailable;
    location @upstream_unavailable {
        default_type application/json;
        return 503 '{"detail":"Service temporarily unavailable"}';
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Credential endpoints get a stricter rate limit (brute-force protection).
    location ~ ^/api/users/(login|register|refresh)$ {
        limit_req zone=auth_zone burst=10 nodelay;
        proxy_pass $user_service;
    }

    location /api/users {
        limit_req zone=api_zone burst=40 nodelay;
        proxy_pass $user_service;
    }

    # Domain services. Custom headers such as Idempotency-Key pass through unchanged.
    location /api/products {
        limit_req zone=api_zone burst=40 nodelay;
        proxy_pass $product_service;
    }

    location /api/orders {
        limit_req zone=api_zone burst=40 nodelay;
        proxy_pass $order_service;
    }

    location /api/payments {
        limit_req zone=api_zone burst=40 nodelay;
        proxy_pass $payment_service;
    }

    location / {
        default_type application/json;
        return 404 '{"detail":"Not found"}';
    }
}
