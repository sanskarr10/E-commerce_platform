{
  "name": "ecommerce-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React storefront and admin panel for the e-commerce platform.",
  "type": "module",
  "workspaces": [
    "shared",
    "storefront",
    "admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:storefront": "npm run dev -w storefront",
    "dev:admin": "npm run dev -w admin",
    "dev:mock": "node mock-api/server.mjs",
    "build": "npm run build -w storefront && npm run build -w admin",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
